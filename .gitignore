# 超短裙 AI 短视频系统 Open Source .gitignore

# ============================================
# 1. 敏感信息与个人数据
# ============================================
.env
.env.*
!.env.example
.gitconfig
USER.md
IDENTITY.md
SOUL.md
MEMORY.md
MEMORY_APPEND.md
MEMORY_*.md
memory-ltm-archive.md
memory-stm-archive.md
AGENTS.md
memory/
memory_*/
memorized_diary/
memorized_diary/
memory-*.md
backup/

# ============================================
# 2. API 密钥与凭证
# ============================================
*.key
*.pem
*.p12
*.pfx
secrets/
credentials/
credentials.json
secrets.json

# ============================================
# 3. 运行时产出与输出
# ============================================
output/
productions/
production/
productions-*/
videos/
checkpoints/
debug_llm/
logs/
*.log
running-status.json
episodes.json
dist/
build/

# ============================================
# 4. 备份与调试目录
# ============================================
analysis/
.trash/
*.tmp
*.temp
*~
.DS_Store
Thumbs.db

# ============================================
# 5. 测试执行脚本（含硬编码内容）
# ============================================
test-*.js
!tests/*.js
run-*.js
run-*.sh
submit-*.sh
submit-*.js
generate-*.js
export-*.js
export-*.sh
pack-*.js
pack-*.sh
tmp-*.js
diagnostic-report-*.md
system-issue-analysis-*.md
oom-analysis-report-*.md
nirath-*.md

# ============================================
# 6. 诊断与报告文件
# ============================================
health-scan-report.md
*-diagnosis-*.md
*-diagnostic-*.md
*-analysis-*.md
*-report-*.md
*-fix-*.md
IMPLEMENTATION_REPORT.md

# ============================================
# 7. 旧版本发布说明（仅保留最新）
# ============================================
RELEASE-v1.*
RELEASE-v2.*
RELEASE-v3.*
RELEASE-v4.*
RELEASE-v5.*
RELEASE-v6.*
RELEASE-v7.*
RELEASE-v8.*
RELEASE_v*
v6.*-release*.md
v6.*-patch*.md
v0.*-release*.md

# ============================================
# 8. Node.js
# ============================================
node_modules/
package-lock.json

# ============================================
# 9. IDE
# ============================================
.vscode/
.idea/
*.swp
*.swo

# ============================================
# 10. 角色数据（由引擎生成）
# ============================================
characters/*/portraits/
characters/*/portraits-v*/
characters/*/reference-photos/
characters/*/character-card.json
characters/*/generation-meta.json

# ============================================
# 11. 语音数据
# ============================================
voice-craft-data/

# 生产过程数据（保留本地，不进入仓库）
characters/
products/
projects/
stories/
debug_llm/
