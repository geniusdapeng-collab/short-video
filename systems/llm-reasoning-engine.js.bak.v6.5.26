/**
 * LLM 推理引擎 (LLM Reasoning Engine) v1.0
 * 系统核心模块：为所有关键 Stage 提供真实 LLM 推理能力
 * 
 * v6.3-patch5-expert-fix: 使用 node-fetch 替代内置 fetch，解决 AbortController 超时不可靠问题
 */

'use strict';

const fetch = require('node-fetch');

/**
 * v6.2-patch79: 从推理模型的思维链文本中提取JSON
 * 推理模型特性：reasoning_content包含思维过程+末尾的JSON答案
 * 策略：从文本末尾找到最后一个JSON对象，而非直接返回完整思维链
 */
function extractJSONFromReasoning(text) {
  if (!text || text.trim().length === 0) return null;
  
  // 策略1：从末尾找最后一个 }，向前回溯到对应的 {
  let lastBrace = text.lastIndexOf('}');
  if (lastBrace < 0) return null;
  
  // 从lastBrace向前扫描，找到匹配的 {
  let braceCount = 0;
  let startIndex = -1;
  for (let i = lastBrace; i >= 0; i--) {
    if (text[i] === '}') braceCount++;
    if (text[i] === '{') braceCount--;
    if (braceCount === 0) {
      startIndex = i;
      break;
    }
  }
  
  if (startIndex < 0) return null;
  
  const candidate = text.substring(startIndex, lastBrace + 1);
  
  try {
    JSON.parse(candidate);
    return candidate;
  } catch (e) {
    // 策略2：如果末尾JSON解析失败，尝试找第一个有效的JSON
    // 这在思维链中间嵌入了JSON时有用
  }
  
  // 策略2：正则匹配所有JSON对象，返回最长的有效JSON
  const jsonMatches = text.match(/\{[\s\S]*?\}/g);
  if (jsonMatches) {
    for (let i = jsonMatches.length - 1; i >= 0; i--) {
      try {
        // 尝试解析，确保是完整的JSON
        const parsed = JSON.parse(jsonMatches[i]);
        // 如果解析成功，还要验证它是否是"有意义"的JSON（不是空对象）
        if (Object.keys(parsed).length > 0) {
          return jsonMatches[i];
        }
      } catch (e) {
        // 继续尝试前一个
      }
    }
  }
  
  return null;
}

class LLMEngine {
  constructor(options = {}) {
    // 模型配置
    this.model = options.model || 'kimi-k2p6'; // 默认使用当前模型
    this.maxTokens = options.maxTokens || 2000;
    this.timeoutMs = options.timeoutMs || 600000; // v6.2-patch80: 默认10分钟超时
    this.temperature = options.temperature || 1; // 模型要求 temperature 必须为 1
    this.topP = options.topP || 0.95; // 模型要求 top_p 必须为 0.95
    
    // 重试配置
    this.maxRetries = options.maxRetries || 3;
    this.retryDelay = options.retryDelay || 1000; // 毫秒
    
    // 上下文管理
    this.contextWindow = options.contextWindow || 8192; // 上下文窗口大小
    this.conversationHistory = []; // 对话历史
    
    // 性能监控
    this.stats = {
      totalCalls: 0,
      totalTokens: 0,
      totalDuration: 0,
      errors: 0
    };
    
    // 模式标识
    this.mode = options.mode || 'production'; // 'production' | 'mock'
    
    console.log(`[LLMEngine] 🧠 LLM 推理引擎初始化 | 模型: ${this.model} | 模式: ${this.mode}`);
  }

  /**
   * 获取原始推理结果（严格分离content和reasoning_content）
   * v6.2-patch118: 新增方法，上层代码可自由选择如何处理
   * @param {string} prompt - 推理提示词
   * @param {Object} options - 推理选项
   * @returns {Object} { content, reasoning_content, tokenCount, ... }
   */
  async reasonRaw(prompt, options = {}) {
    const result = await this.reason(prompt, options);
    
    // 如果content为空但reasoning_content有内容，返回原始结构
    // 不做任何合并或伪装，让调用者决定
    return {
      success: result.success,
      content: result.content || '', // 可能为空
      reasoning_content: result.reasoning_content || '', // 原始思维链
      tokenCount: result.tokenCount,
      duration: result.duration,
      callId: result.callId,
      model: result.model,
      attempt: result.attempt,
      // 如果content为空，提示上层
      hasContent: !!(result.content && result.content.trim().length > 0),
      hasReasoning: !!(result.reasoning_content && result.reasoning_content.trim().length > 0)
    };
  }

  /**
   * 核心推理方法：调用 LLM 进行真实推理
   * @param {string} prompt - 推理提示词
   * @param {Object} options - 推理选项
   * @returns {Object} 推理结果
   */
  async reason(prompt, options = {}) {
    const startTime = Date.now();
    const callId = `llm-${Date.now()}-${Math.random().toString(36).substring(2, 8)}`;
    
    console.log(`\n[LLMEngine] 🧠 [${callId}] 开始推理...`);
    console.log(`[LLMEngine] 📤 Prompt长度: ${prompt.length} 字符`);
    
    // 构建上下文
    const context = this._buildContext(prompt, options);
    
    // 执行推理（带重试）
    let lastError = null;
    for (let attempt = 1; attempt <= this.maxRetries; attempt++) {
      try {
        console.log(`[LLMEngine] 🔄 [${callId}] 第 ${attempt}/${this.maxRetries} 次尝试...`);
        
        const result = await this._callModel(context, options);
        
        // 更新统计
        const duration = Date.now() - startTime;
        this.stats.totalCalls++;
        this.stats.totalDuration += duration;
        this.stats.totalTokens += result.tokenCount || 0;
        
        console.log(`[LLMEngine] ✅ [${callId}] 推理完成 | 耗时: ${duration}ms | Tokens: ${result.tokenCount || 'unknown'}`);
        console.log(`[LLMEngine] 📥 输出长度: ${result.content.length} 字符`);
        
        return {
          success: true,
          content: result.content,
          reasoning_content: result.reasoning_content || '', // 新增：返回原始思维链
          tokenCount: result.tokenCount,
          duration,
          callId,
          model: this.model,
          attempt
        };
        
      } catch (error) {
        lastError = error;
        this.stats.errors++;
        console.error(`[LLMEngine] ❌ [${callId}] 第 ${attempt} 次尝试失败: ${error.message}`);
        
        if (attempt < this.maxRetries) {
          console.log(`[LLMEngine] ⏳ [${callId}] ${this.retryDelay}ms 后重试...`);
          await this._sleep(this.retryDelay);
        }
      }
    }
    
    // 所有重试失败，返回fallback标记
    console.error(`[LLMEngine] 💥 [${callId}] 全部 ${this.maxRetries} 次尝试失败，返回fallback`);
    return {
      success: false,
      fallback: true,
      content: this._generateMockContent(prompt),
      tokenCount: 500,
      duration: Date.now() - startTime,
      callId,
      attempts: this.maxRetries,
      error: lastError?.message
    };
  }

  /**
   * 批量推理：对多个提示词进行并行推理
   * @param {Array<string>} prompts - 提示词数组
   * @param {Object} options - 推理选项
   * @returns {Array<Object>} 推理结果数组
   */
  async reasonBatch(prompts, options = {}) {
    console.log(`[LLMEngine] 🧠 批量推理开始 | 数量: ${prompts.length}`);
    
    const results = [];
    for (let i = 0; i < prompts.length; i++) {
      console.log(`[LLMEngine] 🔄 批量推理 ${i + 1}/${prompts.length}...`);
      const result = await this.reason(prompts[i], options);
      results.push(result);
      
      // 批次间延迟，避免过载
      if (i < prompts.length - 1) {
        await this._sleep(options.batchDelay || 500);
      }
    }
    
    console.log(`[LLMEngine] ✅ 批量推理完成 | 成功: ${results.filter(r => r.success).length}/${prompts.length}`);
    return results;
  }

  /**
   * v6.5.16: 清空缓存，防止内存累积
   * 在批次间调用，释放conversationHistory和临时状态
   */
  clearCache() {
    const prevSize = this.conversationHistory?.length || 0;
    this.conversationHistory = [];
    console.log(`[LLMEngine] 🗑️ 缓存已清理 | 对话历史: ${prevSize} → 0`);
  }

  /**
   * 结构化推理：要求 LLM 输出 JSON 格式
   * @param {string} prompt - 推理提示词
   * @param {Object} schema - 期望的 JSON 结构
   * @param {Object} options - 推理选项
   * @returns {Object} 解析后的 JSON 对象
   */
  async reasonStructured(prompt, schema, options = {}) {
    const structuredPrompt = `${prompt}\n\n【输出格式要求】\n请严格按以下 JSON 格式输出，不要包含任何其他内容：\n\n${JSON.stringify(schema, null, 2)}\n\n注意：只输出 JSON，不要任何解释、前缀或后缀。`;
    
    const result = await this.reason(structuredPrompt, options);
    
    if (!result.success) {
      return { success: false, error: result.error };
    }
    
    try {
      // v6.2-patch79: 增强JSON提取——先尝试标准提取，失败则尝试从思维链提取
      let jsonStr = result.content;
      
      // 步骤1：尝试markdown代码块提取
      const codeBlockMatch = result.content.match(/```json\n?([\s\S]*?)\n?```/);
      if (codeBlockMatch) {
        jsonStr = codeBlockMatch[1];
      } else {
        // 步骤2：尝试找到第一个 { 和最后一个 }
        const firstBrace = result.content.indexOf('{');
        const lastBrace = result.content.lastIndexOf('}');
        if (firstBrace >= 0 && lastBrace > firstBrace) {
          jsonStr = result.content.substring(firstBrace, lastBrace + 1);
        }
      }
      
      // 步骤3：如果解析失败且内容包含思维链特征，尝试从思维链提取JSON
      let parsed = null;
      try {
        parsed = JSON.parse(jsonStr.trim());
      } catch (e1) {
        // 如果标准提取失败，尝试从思维链提取
        const extracted = extractJSONFromReasoning(result.content);
        if (extracted && extracted !== jsonStr) {
          console.log(`[LLMEngine] 🔄 reasonStructured: 标准提取失败，从思维链提取JSON | 长度: ${extracted.length}`);
          jsonStr = extracted;
          try {
            parsed = JSON.parse(jsonStr.trim());
          } catch (e2) {
            // 继续到下面的修复逻辑
          }
        }
      }
      
      // 步骤4：如果仍未解析成功，尝试修复截断的JSON
      if (!parsed) {
        let fixedJsonStr = jsonStr.trim();
        const openBraces = (fixedJsonStr.match(/\{/g) || []).length;
        const closeBraces = (fixedJsonStr.match(/\}/g) || []).length;
        const openBrackets = (fixedJsonStr.match(/\[/g) || []).length;
        const closeBrackets = (fixedJsonStr.match(/\]/g) || []).length;
        
        // 补全缺少的闭合括号
        while (closeBraces < openBraces) {
          fixedJsonStr += '}';
        }
        while (closeBrackets < openBrackets) {
          fixedJsonStr += ']';
        }
        
        parsed = JSON.parse(fixedJsonStr);
      }
      
      return {
        success: true,
        data: parsed,
        rawContent: result.content,
        duration: result.duration
      };
    } catch (parseError) {
      console.error(`[LLMEngine] ❌ JSON 解析失败: ${parseError.message}`);
      console.error(`[LLMEngine] 📄 原始内容(前200字符): ${result.content.substring(0, 200)}`);
      return {
        success: false,
        error: `JSON parse error: ${parseError.message}`,
        rawContent: result.content
      };
    }
  }

  /**
   * 对话模式推理：带上下文的连续推理
   * @param {string} prompt - 当前轮次的提示词
   * @param {Object} options - 推理选项
   * @returns {Object} 推理结果
   */
  async reasonWithContext(prompt, options = {}) {
    // 将当前对话加入历史
    this.conversationHistory.push({ role: 'user', content: prompt });
    
    // 裁剪过长的历史
    this._trimHistory();
    
    // 构建完整上下文
    const fullContext = this.conversationHistory.map(h => 
      `${h.role === 'user' ? '用户' : '助手'}: ${h.content}`
    ).join('\n\n');
    
    const result = await this.reason(fullContext, options);
    
    if (result.success) {
      // 将助手回复加入历史
      this.conversationHistory.push({ role: 'assistant', content: result.content });
    }
    
    return result;
  }

  /**
   * 获取统计信息
   */
  getStats() {
    return {
      ...this.stats,
      avgDuration: this.stats.totalCalls > 0 ? this.stats.totalDuration / this.stats.totalCalls : 0,
      avgTokens: this.stats.totalCalls > 0 ? this.stats.totalTokens / this.stats.totalCalls : 0,
      successRate: this.stats.totalCalls > 0 ? (this.stats.totalCalls - this.stats.errors) / this.stats.totalCalls : 0
    };
  }

  /**
   * 重置对话历史
   */
  resetContext() {
    this.conversationHistory = [];
    console.log('[LLMEngine] 🔄 对话上下文已重置');
  }

  // ==================== 私有方法 ====================

  /**
   * 构建上下文
   */
  _buildContext(prompt, options) {
    const context = {
      model: options.model || this.model,
      messages: [
        {
          role: 'system',
          content: options.systemPrompt || '你是一个专业的AI视频制作助手，擅长剧本创作、导演评估和编剧优化。请提供高质量的创意内容。'
        },
        {
          role: 'user',
          content: prompt
        }
      ],
      max_tokens: options.maxTokens || this.maxTokens,
      temperature: options.temperature || this.temperature || 1,
      top_p: options.top_p || this.topP || 0.95,
    };
    
    return context;
  }

  /**
   * 调用模型（实际实现）
   * v6.2-patch70: 使用 Kimi API 进行真实推理
   * 直接调用配置中的模型 API（anthropic-messages 格式）
   */
  async _callModel(context, options) {
    // 在 OpenClaw 环境中，使用内置模型能力
    
    if (this.mode === 'mock') {
      console.log('[LLMEngine] 🧪 Mock 模式：返回模拟推理结果');
      await this._sleep(100);
      return {
        content: '【Mock推理结果】这是模拟的 LLM 推理输出。',
        tokenCount: 50
      };
    }
    
    // 生产模式：直接调用 Kimi API
    console.log('[LLMEngine] 🌐 调用 Kimi API 进行真实推理...');
    
    const userPrompt = context.messages[1]?.content || '';
    const systemPrompt = context.messages[0]?.content || '';
    
    // 读取配置 - 修复配置路径
    const config = require('/root/.openclaw/openclaw.json');
    // 配置在 agents.defaults.memorySearch.remote 路径下
    const remoteConfig = config?.agents?.defaults?.memorySearch?.remote;
    
    if (!remoteConfig || !remoteConfig.apiKey) {
      throw new Error('未找到 Kimi API 配置（请检查 openclaw.json 的 agents.defaults.memorySearch.remote）');
    }
    
    const apiKey = remoteConfig.apiKey;
    const baseUrl = remoteConfig.baseUrl || 'https://agent-gw.kimi.com/coding/v1';
    const modelId = context.model || this.model;
    
    // 构建 anthropic-messages 格式请求
    const requestBody = {
      model: modelId,
      max_tokens: options.maxTokens || this.maxTokens,
      temperature: options.temperature || this.temperature || 1,
      top_p: options.top_p || this.topP || 0.95,
      messages: [
        {
          role: 'system',
          content: systemPrompt
        },
        {
          role: 'user',
          content: userPrompt
        }
      ]
    };
    
    try {
      console.log(`[LLMEngine] 📤 发送请求到 ${baseUrl}/chat/completions...`);
      
      // v6.3-patch5-expert-fix: 使用 node-fetch 替代内置 fetch，解决超时不可靠问题
      // 设置：connectTimeout 30秒 + requestTimeout 3分钟（可覆盖）
      const timeoutMs = options.timeoutMs || this.timeoutMs || 180000; // 默认3分钟
      console.log(`[LLMEngine] ⏱️ 超时设置: ${timeoutMs}ms (options.timeoutMs=${options.timeoutMs}, this.timeoutMs=${this.timeoutMs})`);
      
      // 双保险超时：AbortController + Promise.race
      const controller = new AbortController();
      const timeoutId = setTimeout(() => {
        controller.abort();
      }, timeoutMs);
      
      // 使用 node-fetch 的 timeout 选项（更可靠）
      const response = await Promise.race([
        fetch(`${baseUrl}/chat/completions`, {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
            'Authorization': `Bearer ${apiKey}`,
            'User-Agent': 'Kimi Claw Plugin',
            'X-Kimi-Claw-ID': '19e2af44-e972-8463-8000-0000ed50f587'
          },
          body: JSON.stringify(requestBody),
          signal: controller.signal,
          timeout: timeoutMs + 10000 // 额外10秒缓冲
        }),
        new Promise((_, reject) => {
          setTimeout(() => reject(new Error('Request timeout (Promise.race)')), timeoutMs + 5000);
        })
      ]);
      
      clearTimeout(timeoutId);
      
      if (!response.ok) {
        throw new Error(`HTTP ${response.status}: ${await response.text()}`);
      }
      
      const result = await response.json();
      
      if (result.error) {
        throw new Error(`API 错误: ${result.error.message || result.error}`);
      }
      
      // 兼容 OpenAI 格式 (choices[0].message.content) 和 anthropic 格式 (content[0].text)
      let content = result.choices?.[0]?.message?.content 
        || result.content?.[0]?.text 
        || result.content 
        || result.text 
        || '';
      
      // 获取reasoning_content（如果存在）
      const reasoningContent = result.choices?.[0]?.message?.reasoning_content || '';
      
      // v6.2-patch118: 严格分离content和reasoning_content
      // 当content为空时，不再把reasoning_content伪装进content
      // 上层代码（如promptforge-utils）会自行处理提取逻辑
      let finalContent = content;
      let finalReasoning = reasoningContent;
      
      if (!finalContent || finalContent.trim().length === 0) {
        if (reasoningContent && reasoningContent.trim().length > 0) {
          console.log(`[LLMEngine] 🧠 content为空，但reasoning_content有${reasoningContent.length}字符。请上层调用者自行提取。`);
          // v6.5.21-fix: 当content为空时，从reasoning_content提取最后2000字符作为content
          // 防止reasonStructured因content为空而解析失败
          finalContent = reasoningContent.slice(-2000);
          console.log(`[LLMEngine] 🔄 从reasoning_content提取最后2000字符作为content备用`);
        } else {
          // 如果reasoning_content也为空，才抛错
          console.error(`[LLMEngine] ⚠️ API返回空内容！finish_reason: ${result.choices?.[0]?.finish_reason || 'unknown'}`);
          throw new Error('API返回空内容，模型进入思考模式或输出被截断');
        }
      }
      
      const tokenCount = result.usage?.output_tokens || result.usage?.completion_tokens || Math.floor(finalContent.length * 1.5);
      
      console.log(`[LLMEngine] ✅ API 推理完成 | Tokens: ${tokenCount}`);
      
      // 返回时严格分离content和reasoning_content，不再互相伪装
      return { 
        content: finalContent, // 可能为空（当模型只返回reasoning时）
        reasoning_content: finalReasoning, // 原始思维链，永远保留
        tokenCount 
      };
      
    } catch (error) {
      // v6.2-patch115-fix: abort错误立即重试一次（可能是临时网络问题）
      if (error.name === 'AbortError' || error.message?.includes('aborted') || error.message?.includes('Abort')) {
        console.log(`[LLMEngine] 🔄 API调用被中断(abort)，立即重试一次...`);
        try {
          // v6.3-patch5-expert-fix: 重试超时设置为5分钟
          const retryTimeoutMs = 300000; // 5分钟
          
          // 直接用新的controller重试，设置5分钟超时
          // v6.3-patch5-expert-fix: 使用 node-fetch 替代内置 fetch
          const retryController = new AbortController();
          const retryTimeoutId = setTimeout(() => {
            retryController.abort();
          }, retryTimeoutMs);
          
          const retryResponse = await Promise.race([
            fetch(`${baseUrl}/chat/completions`, {
              method: 'POST',
              headers: {
                'Content-Type': 'application/json',
                'Authorization': `Bearer ${apiKey}`,
                'User-Agent': 'Kimi Claw Plugin',
                'X-Kimi-Claw-ID': '19e2af44-e972-8463-8000-0000ed50f587'
              },
              body: JSON.stringify(requestBody),
              signal: retryController.signal,
              timeout: retryTimeoutMs + 10000
            }),
            new Promise((_, reject) => {
              setTimeout(() => reject(new Error('Retry timeout (Promise.race)')), retryTimeoutMs + 5000);
            })
          ]);
          
          clearTimeout(retryTimeoutId);
          
          if (!retryResponse.ok) {
            throw new Error(`HTTP ${retryResponse.status}: ${await retryResponse.text()}`);
          }
          
          const retryResult = await retryResponse.json();
          
          if (retryResult.error) {
            throw new Error(`API 错误: ${retryResult.error.message || retryResult.error}`);
          }
          
          let retryContent = retryResult.choices?.[0]?.message?.content 
            || retryResult.content?.[0]?.text 
            || retryResult.content 
            || retryResult.text 
            || '';
          
          const retryReasoning = retryResult.choices?.[0]?.message?.reasoning_content || '';
          
          if (!retryContent || retryContent.trim().length === 0) {
            if (retryReasoning && retryReasoning.trim().length > 0) {
              console.log(`[LLMEngine] 🧠 重试后content为空，但reasoning_content有${retryReasoning.length}字符。`);
              // 不伪装，返回原始结构
            } else {
              throw new Error('重试后API仍返回空内容');
            }
          }
          
          if (!retryContent || retryContent.trim().length === 0) {
            throw new Error('重试后API仍返回空内容');
          }
          
          const tokenCount = retryResult.usage?.output_tokens || retryResult.usage?.completion_tokens || Math.floor((retryContent.length + retryReasoning.length) * 1.5);
          console.log(`[LLMEngine] ✅ 重试成功 | Tokens: ${tokenCount}`);
          return { content: retryContent, reasoning_content: retryReasoning, tokenCount };
          
        } catch (retryError) {
          console.error(`[LLMEngine] ❌ 重试也失败: ${retryError.message}`);
        }
      }
      
      // 所有尝试失败，抛出错误（让外层重试逻辑捕获）
      console.error(`[LLMEngine] ❌ API 调用失败: ${error.message}`);
      throw error;
    }
  }

  /**
   * 生成模拟内容（用于开发和测试）
   */
  _generateMockContent(prompt) {
    // v6.2-patch78-fix: 返回严格JSON格式，不是中文描述文本
    if (prompt.includes('剧本') || prompt.includes('故事')) {
      return JSON.stringify({
        scenes: [{
          id: 'S01',
          scene: '开场',
          narration: '小G站在钩吾废墟边缘，远古战争摧毁的城市遗迹展现在眼前。',
          type: 'opening',
          characters: ['xiaoG'],
          mouthAction: 'speaking_whisper',
          emotionPhase: 'curiosity',
          importance: 8,
          visualComplexity: 7,
          visualPrompt: '超写实，电影级光影，废墟场景，暗红色熔岩光',
          beastDialogue: ''
        }]
      });
    }
    
    if (prompt.includes('导演') || prompt.includes('评估')) {
      return JSON.stringify({
        score: 83,
        issues: ['可增加一镜到底镜头'],
        suggestions: ['结尾强化主题升华'],
        passed: true
      });
    }
    
    if (prompt.includes('优化') || prompt.includes('编剧')) {
      return JSON.stringify({
        optimized: true,
        changes: ['时长调整', '台词重构'],
        expectedScore: 90
      });
    }
    
    return JSON.stringify({
      result: '推理完成',
      prompt: prompt.substring(0, 100)
    });
  }

  /**
   * 裁剪对话历史（保持上下文窗口）
   */
  _trimHistory() {
    const totalLength = this.conversationHistory.reduce((sum, h) => sum + h.content.length, 0);
    
    while (totalLength > this.contextWindow && this.conversationHistory.length > 2) {
      // 移除最早的用户-助手对话对（保留系统提示）
      this.conversationHistory.shift();
      if (this.conversationHistory.length > 0 && this.conversationHistory[0].role === 'assistant') {
        this.conversationHistory.shift();
      }
    }
  }

  /**
   * 延迟工具
   */
  _sleep(ms) {
    return new Promise(resolve => setTimeout(resolve, ms));
  }
}

module.exports = { LLMEngine };

// 集成测试
if (require.main === module) {
  async function test() {
    console.log('=== LLM 推理引擎测试 ===\n');
    
    const engine = new LLMEngine({ mode: 'mock' });
    
    // 测试 1：基础推理
    console.log('--- 测试 1：基础推理 ---');
    const result1 = await engine.reason('请生成一个关于饕餮的故事剧本');
    console.log('成功:', result1.success);
    console.log('耗时:', result1.duration, 'ms');
    console.log('输出前100字:', result1.content.substring(0, 100));
    
    // 测试 2：结构化推理
    console.log('\n--- 测试 2：结构化推理 ---');
    const result2 = await engine.reasonStructured(
      '请评估以下镜头方案的质量',
      { score: 0, issues: [], suggestions: [] }
    );
    console.log('成功:', result2.success);
    if (result2.success) {
      console.log('数据结构:', JSON.stringify(result2.data, null, 2).substring(0, 200));
    }
    
    // 测试 3：统计信息
    console.log('\n--- 测试 3：统计信息 ---');
    console.log('统计:', engine.getStats());
  }
  
  test().catch(console.error);
}
